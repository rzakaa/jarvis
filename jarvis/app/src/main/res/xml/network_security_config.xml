<?xml version="1.0" encoding="utf-8"?>
<!--
  Tylko wersja debug (emulator) ufa certyfikatom dodanym przez użytkownika – np. antywirus
  na komputerze (Norton) podmienia certyfikaty HTTPS. Wersja release ufa wyłącznie systemowym.
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
